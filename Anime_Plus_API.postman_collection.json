  "item": [
    {
      "name": "1. Authentication (المصادقة)",
      "item": [
        {
          "name": "Register (إنشاء حساب جديد)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.accessToken) {",
                  "    pm.collectionVariables.set(\"access_token\", response.accessToken);",
                  "    console.log(\"Access token automatically updated from Registration!\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"yusuf_gamer\",\n  \"email\": \"yusuf@example.com\",\n  \"password\": \"OtakuPass123!\",\n  \"confirmPassword\": \"OtakuPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Creates a new local user account. The password must contain at least 8 characters, with 1 uppercase letter and 1 number."
          },
          "response": []
        },
        {
          "name": "Login (تسجيل الدخول)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.accessToken) {",
                  "    pm.collectionVariables.set(\"access_token\", response.accessToken);",
                  "    console.log(\"Access token automatically updated from Login!\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"otaku@example.com\",\n  \"password\": \"OtakuPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Logs in the user and returns an accessToken. A refreshToken is also returned as an HTTP-only cookie."
          },
          "response": []
        },
        {
          "name": "Get Me (بيانات المستخدم الحالي)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Retrieves information about the currently authenticated user."
          },
          "response": []
        },
        {
          "name": "Refresh Token (تحديث الرمز)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.accessToken) {",
                  "    pm.collectionVariables.set(\"access_token\", response.accessToken);",
                  "    console.log(\"Access token automatically refreshed and updated!\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
            "description": "Rotates refresh tokens and returns a new access token. Requires the refreshToken to be sent via cookie."
          },
          "response": []
        },
        {
          "name": "Logout (تسجيل الخروج)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Logs out the user and clears the refreshToken cookie."
          },
          "response": []
        },
        {
          "name": "Revoke All Devices (تسجيل الخروج من كل الأجهزة)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/revoke-all",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "revoke-all"
              ]
            },
            "description": "Logs out the user from all devices by deleting all active refresh tokens in the database."
          },
          "response": []
        },
        {
          "name": "Google OAuth Login (تسجيل دخول جوجل)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/google",
